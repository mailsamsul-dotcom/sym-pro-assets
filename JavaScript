    function saveOrderDetail(actionType, timData = null) {
        const rowData = globalDailyRows[currentEditingRowIndex];
        function getVal(colName) { let targetClean = colName.toLowerCase(); let idx = globalDailyHeaders.findIndex(h => String(h).trim().toLowerCase() === targetClean); if (idx === -1 && targetClean.includes("order id tsel")) idx = globalDailyHeaders.findIndex(h => { let hc = String(h).trim().toLowerCase(); return hc.includes("sc order no") || hc.includes("csrm"); }); return (idx !== -1 && rowData[idx] !== undefined && rowData[idx] !== null) ? String(rowData[idx]).trim() : ""; }
        let sheetTargetName = 'List Daily Order'; if (currentActiveMode === 'order-kendala') sheetTargetName = 'Order Kendala'; else if (currentActiveMode === 'order-completed') sheetTargetName = 'Order Completed';
