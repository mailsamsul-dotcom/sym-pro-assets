    function toggleEditMode(section) { if(section === 'order') { isOrderEditMode = !isOrderEditMode; const btn = document.getElementById('btn-edit-order'); if(isOrderEditMode) { btn.innerHTML = `<i class="fa-solid fa-xmark mr-1"></i> Batal Edit`; btn.className = "px-3 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-lg font-semibold text-[11px] transition"; } else { btn.innerHTML = `<i class="fa-solid fa-pen-to-square mr-1"></i> Update`; btn.className = "px-3 py-1 bg-blue-50 hover:bg-blue-100 text-[#0d55d4] rounded-lg font-semibold text-[11px] transition"; } renderModalContent(); } }
