<script>
    let tempUser = "";
    let globalDailyHeaders = []; let globalDailyRows = [];
    let currentEditingRowIndex = -1; let isOrderEditMode = false;
    
    let techniciansCache = []; let errorCodesCache = []; let mappingTimCache = [];
    let currentActiveMode = 'daily-order';

    let modeDataCache = { 'list-daily-order': null, 'order-kendala': null, 'order-completed': null };

    let donutChartInstance = null; let mapInstance = null;
    
    // Map Geocoding Variables
    let geocodeCache = JSON.parse(localStorage.getItem('sympro_geocode_cache') || '{}');
    let geocodeQueue = [];
    let isGeocoding = false;

    // Global State for Dashboard Modal Filtering
    window.dashFilteredData = { total: {all:[], create:[], migrate:[], modify:[]}, kp: {all:[], create:[], migrate:[], modify:[]}, kt: {all:[], create:[], migrate:[], modify:[]}, op: {all:[], create:[], migrate:[], modify:[]}, comp: {all:[], create:[], migrate:[], modify:[]} };

    function getCacheKeyForMode(mode) {
        if (mode === 'daily-order' || mode === 'order-hi' || mode === 'daily-report') return 'list-daily-order';
        if (mode === 'order-kendala') return 'order-kendala';
        if (mode === 'order-completed') return 'order-completed'; return mode;
    }

    let currentSortCol = null; let currentSortDir = 'asc';

    function applyRoleAccess(role) {
        const roleLower = String(role).toLowerCase(); const manageUserMenu = document.getElementById('menu-manage-user');
        if (manageUserMenu) {
            if (roleLower === 'superadmin') { manageUserMenu.classList.remove('hidden'); manageUserMenu.classList.add('flex'); } 
            else { manageUserMenu.classList.add('hidden'); manageUserMenu.classList.remove('flex'); }
        }
    }

    window.onload = function() {
        const savedUser = localStorage.getItem("sym_pro_user"); const savedRole = localStorage.getItem("sym_pro_role");

        const today = new Date(); const dateString = today.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        document.getElementById('dash-date-range').innerText = dateString + " - " + dateString;

        if (savedUser) {
            document.getElementById('auth-bg').style.display = 'none'; document.getElementById('auth-card-container').style.display = 'none';
            document.getElementById('dashboard-wrapper').classList.remove('hidden');
            document.getElementById('user-role-badge').innerText = "Role: " + (savedRole || "USER").toUpperCase();
            applyRoleAccess(savedRole || "user"); switchMenu('daily-report'); loadRecentImports();
        }
        fetchMasterData(); loadMappingTimData(); fetchGlobalUnassignedBadge();
    };

    /* ======= FUNGSI DASHBOARD DI JS ======= */
    function loadDashboardData() {
        const loadingEl = document.getElementById('dash-loading'); const contentEl = document.getElementById('dash-content');
        loadingEl.classList.remove('hidden'); contentEl.classList.add('hidden');

        if (modeDataCache['list-daily-order']) {
            globalDailyHeaders = modeDataCache['list-daily-order'].headers;
            globalDailyRows = modeDataCache['list-daily-order'].rows;
            processDashboardData(globalDailyHeaders, globalDailyRows);
        } else {
            if (typeof google === 'undefined') return;
            google.script.run.withSuccessHandler(function(res) {
                if(res && res.success) {
                    modeDataCache['list-daily-order'] = { headers: res.headers, rows: res.rows };
                    globalDailyHeaders = res.headers;
                    globalDailyRows = res.rows;
                    processDashboardData(res.headers, res.rows);
                } else { showMessage("Gagal memuat data dashboard", "error"); loadingEl.classList.add('hidden'); }
            }).getDailyOrderData();
        }
    }

    function processDashboardData(headersRaw, rows) {
        const headers = headersRaw.map(h => String(h).trim().toLowerCase());
        let leaderIdx = headers.findIndex(h => h === 'leader'); let memberIdx = headers.findIndex(h => h === 'member');
        let crmIdx = headers.findIndex(h => h === 'crm order type'); let errIdx = headers.findIndex(h => h === 'errorcode');
        let subErrIdx = headers.findIndex(h => h === 'suberrorcode'); let memoIdx = headers.findIndex(h => h.includes('engineermemo'));
        let jenisIdx = headers.findIndex(h => h === 'jenis_error' || h === 'status');
        let addrIdx = headers.findIndex(h => h === 'address');
        
        let woIdx = headers.findIndex(h => h.includes('workorder'));
        let tselIdx = headers.findIndex(h => h === 'order id tsel' || h.includes('sc order no') || h.includes('csrm'));
        let custIdx = headers.findIndex(h => h === 'customer name');

        window.dashFilteredData = { total: {all:[], create:[], migrate:[], modify:[]}, kp: {all:[], create:[], migrate:[], modify:[]}, kt: {all:[], create:[], migrate:[], modify:[]}, op: {all:[], create:[], migrate:[], modify:[]}, comp: {all:[], create:[], migrate:[], modify:[]} };

        let stats = { total: {all:0, create:0, migrate:0, modify:0}, kp: {all:0, create:0, migrate:0, modify:0}, kt: {all:0, create:0, migrate:0, modify:0}, op: {all:0, create:0, migrate:0, modify:0}, comp: {all:0, create:0, migrate:0, modify:0}, timSummary: {} };
        let mapPoints = [];

        let timMap = {};
        mappingTimCache.forEach(t => timMap[String(t.leader).trim()] = `${String(t.tim).trim()} (${String(t.leader).trim()} - ${String(t.member).trim()})`);

        rows.forEach((row, idx) => {
            let leader = leaderIdx !== -1 ? String(row[leaderIdx] || "").trim() : "";
            let member = memberIdx !== -1 ? String(row[memberIdx] || "").trim() : "";
            
            if (!leader || leader === "-" || !member || member === "-") return;

            let crmRaw = crmIdx !== -1 ? String(row[crmIdx] || "").trim().toLowerCase() : "";
            let type = "other";
            if (crmRaw.includes("create")) type = "create";
            else if (crmRaw.includes("migrate")) type = "migrate";
            else if (crmRaw.includes("modify")) type = "modify";

            let err = errIdx !== -1 ? String(row[errIdx] || "") : ""; let sub = subErrIdx !== -1 ? String(row[subErrIdx] || "") : "";
            let memo = memoIdx !== -1 ? String(row[memoIdx] || "") : ""; let jenis = jenisIdx !== -1 ? String(row[jenisIdx] || "") : "";
            let comboText = `${err} ${sub} ${memo} ${jenis}`.toUpperCase();

            let category = "op"; 
            if (comboText.includes("COMPLETED") || comboText.includes("PS")) category = "comp";
            else if (comboText.includes("KENDALA PELANGGAN")) category = "kp";
            else if (comboText.includes("KENDALA TEKNIK")) category = "kt";

            let woVal = woIdx !== -1 ? String(row[woIdx] || "").trim() : "-";
            let tselVal = tselIdx !== -1 ? String(row[tselIdx] || "").trim() : "-";
            
            let shortTsel = tselVal;
            let matchTsel = tselVal.match(/-(.*?)(_|$)/); 
            if (matchTsel && matchTsel[1]) {
                shortTsel = matchTsel[1];
            }
            let combinedWoTsel = `${woVal} / ${shortTsel}`;

            let timNameFormatted = timMap[leader] || `${leader} (${member})`;

            let modalObj = {
                originalIndex: idx, 
                wo: combinedWoTsel,
                crm: crmRaw.toUpperCase(),
                cust: custIdx !== -1 ? row[custIdx] : "-",
                statusText: comboText, 
                assign: `${leader} & ${member}`,
                teamKey: timNameFormatted
            };
            
            window.dashFilteredData.total.all.push(modalObj);
            if(window.dashFilteredData.total[type]) window.dashFilteredData.total[type].push(modalObj);
            
            window.dashFilteredData[category].all.push(modalObj);
            if(window.dashFilteredData[category][type]) window.dashFilteredData[category][type].push(modalObj);

            stats.total.all++;
            if(stats.total[type] !== undefined) stats.total[type]++;

            stats[category].all++;
            if(stats[category][type] !== undefined) stats[category][type]++;

            if (!stats.timSummary[timNameFormatted]) stats.timSummary[timNameFormatted] = { total: 0, kp: 0, kt: 0, op: 0, comp: 0 };
            stats.timSummary[timNameFormatted].total++;
            stats.timSummary[timNameFormatted][category]++;

            let addressStr = addrIdx !== -1 ? String(row[addrIdx] || "") : "";
            if (addressStr) {
                let fbCoords = getFallbackCoords(addressStr);
                mapPoints.push({ lat: null, lng: null, fallbackLat: fbCoords[0], fallbackLng: fbCoords[1], wo: woVal, address: addressStr, cat: category });
            }
        });

        let timArray = [];
        for (let t in stats.timSummary) timArray.push({ tim: t, ...stats.timSummary[t] });
        timArray.sort((a, b) => b.total - a.total);
        
        document.getElementById('dash-loading').classList.add('hidden');
        document.getElementById('dash-content').classList.remove('hidden');

        renderDashboardCards(stats);
        renderDashboardTable(timArray);
        renderDonutChart(stats.total.all, stats.comp.all);
        renderMap(mapPoints);
    }

    function getFallbackCoords(addressStr) {
        let hash = 0;
        for (let i = 0; i < addressStr.length; i++) hash = addressStr.charCodeAt(i) + ((hash << 5) - hash);
        let latOffset = (((Math.abs(hash) % 1000) / 10000) * 0.1) - 0.05;
        let lngOffset = ((((Math.abs(hash) >> 3) % 1000) / 10000) * 0.1) - 0.05;
        let jitterLat = (Math.random() - 0.5) * 0.0015;
        let jitterLng = (Math.random() - 0.5) * 0.0015;
        return [-7.28 + latOffset + jitterLat, 112.76 + lngOffset + jitterLng];
    }

    function renderDashboardCards(data) {
        ['c1','c2','c3','c4','c5'].forEach((prefix, i) => {
            let cat = ['total', 'kp', 'kt', 'op', 'comp'][i];
            document.getElementById(`${prefix}-all`).innerText = data[cat].all.toLocaleString();
            document.getElementById(`${prefix}-cr`).innerText = data[cat].create.toLocaleString();
            document.getElementById(`${prefix}-mi`).innerText = data[cat].migrate.toLocaleString();
            document.getElementById(`${prefix}-mo`).innerText = data[cat].modify.toLocaleString();
        });
    }

    function renderDashboardTable(timArray) {
        let tBody = document.getElementById('dash-tim-body'); let tHtml = "";
        let totals = { tot:0, kp:0, kt:0, op:0, comp:0 };
        
        timArray.forEach(t => {
            totals.tot += t.total; totals.kp += t.kp; totals.kt += t.kt; totals.op += t.op; totals.comp += t.comp;
            let pCt = t.total > 0 ? (t.comp / t.total) * 100 : 0;
            let tKeyStr = t.tim.replace(/'/g, "\\'"); 
            
            tHtml += `
            <tr class="hover:bg-gray-50 transition border-b border-gray-50">
                <td class="py-2.5 px-2 font-bold text-gray-800 flex items-center gap-2 text-[10px]"><i class="fa-solid fa-user-group text-blue-500 text-[10px]"></i> ${t.tim}</td>
                <td class="py-2.5 px-2 text-center font-bold text-gray-800 cursor-pointer hover:text-blue-600 hover:bg-blue-50 transition rounded" onclick="openDashDetail('total', 'all', '${tKeyStr}')">${t.total}</td>
                <td class="py-2.5 px-2 text-center font-bold text-gray-800 cursor-pointer hover:text-red-600 hover:bg-red-50 transition rounded" onclick="openDashDetail('kp', 'all', '${tKeyStr}')">${t.kp}</td>
                <td class="py-2.5 px-2 text-center font-bold text-gray-800 cursor-pointer hover:text-orange-600 hover:bg-orange-50 transition rounded" onclick="openDashDetail('kt', 'all', '${tKeyStr}')">${t.kt}</td>
                <td class="py-2.5 px-2 text-center font-bold text-gray-800 cursor-pointer hover:text-yellow-600 hover:bg-yellow-50 transition rounded" onclick="openDashDetail('op', 'all', '${tKeyStr}')">${t.op}</td>
                <td class="py-2.5 px-2 text-center font-bold text-gray-800 cursor-pointer hover:text-green-600 hover:bg-green-50 transition rounded" onclick="openDashDetail('comp', 'all', '${tKeyStr}')">${t.comp}</td>
                <td class="py-2.5 px-2"><div class="w-full bg-gray-200 h-2 rounded-full overflow-hidden"><div class="bg-green-500 h-full rounded-full" style="width: ${pCt}%"></div></div></td>
            </tr>`;
        });
        tBody.innerHTML = tHtml;
        document.getElementById('ft-tot').innerText = totals.tot.toLocaleString(); document.getElementById('ft-kp').innerText = totals.kp.toLocaleString();
        document.getElementById('ft-kt').innerText = totals.kt.toLocaleString(); document.getElementById('ft-op').innerText = totals.op.toLocaleString();
        document.getElementById('ft-comp').innerText = totals.comp.toLocaleString();
    }

    function openDashDetail(category, type, teamKey = null) {
        let listData = window.dashFilteredData[category][type] || [];
        
        if (teamKey) {
            listData = listData.filter(item => item.teamKey === teamKey);
        }

        let tbody = document.getElementById('dash-detail-body');
        tbody.innerHTML = "";
        
        let catName = category === 'total' ? 'Semua Order' : (category === 'kp' ? 'Kendala Pelanggan' : (category === 'kt' ? 'Kendala Teknik' : (category === 'op' ? 'On Progress' : 'Completed')));
        let typeName = type === 'all' ? 'Seluruh Tipe' : type.toUpperCase();
        
        let titlePrefix = teamKey ? `<i class="fa-solid fa-user-group"></i> ${teamKey} - ` : `<i class="fa-solid fa-table-list"></i> `;
        document.getElementById('dash-modal-title').innerHTML = `${titlePrefix}${catName} (${typeName})`;
        
        if (listData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-gray-400">Tidak ada data.</td></tr>`;
        } else {
            let html = "";
            listData.forEach(item => {
                let badgeColor = "#3b82f6";
                if(item.statusText.includes("COMPLETED") || item.statusText.includes("PS")) badgeColor = "#22c55e";
                else if(item.statusText.includes("KENDALA PELANGGAN")) badgeColor = "#ef4444";
                else if(item.statusText.includes("KENDALA TEKNIK")) badgeColor = "#f97316";
                else if(item.statusText.includes("AKTIVASI")) badgeColor = "#15803d";
                
                let statusHtml = item.statusText ? `<span class="px-2 py-0.5 rounded text-[9px] font-bold text-white shadow-xs" style="background-color: ${badgeColor};">${item.statusText}</span>` : "-";

                html += `<tr class="hover:bg-blue-50 transition border-b border-gray-100">
                    <td class="py-2.5 px-3 font-bold text-blue-600 cursor-pointer hover:underline" onclick="openDetailModal(${item.originalIndex})">${item.wo}</td>
                    <td class="py-2.5 px-3 text-gray-600">${item.crm}</td>
                    <td class="py-2.5 px-3 text-gray-600">${item.cust}</td>
                    <td class="py-2.5 px-3 text-gray-600 max-w-[200px] truncate" title="${item.statusText}">${statusHtml}</td>
                    <td class="py-2.5 px-3 font-semibold text-gray-800 text-[10px]"><i class="fa-solid fa-users text-gray-400 mr-1"></i> ${item.assign}</td>
                </tr>`;
            });
            tbody.innerHTML = html;
        }
        document.getElementById('dash-modal-count').innerText = `Total: ${listData.length} data`;
        document.getElementById('dash-detail-modal').classList.remove('hidden');
    }

    function closeDashDetail() { document.getElementById('dash-detail-modal').classList.add('hidden'); }

    function renderDonutChart(total, comp) {
        let sisa = total - comp; let ratio = total > 0 ? (comp / total * 100).toFixed(2) : 0;
        document.getElementById('chart-pct').innerText = ratio + "%"; document.getElementById('ch-tot').innerText = total.toLocaleString();
        document.getElementById('ch-comp').innerText = comp.toLocaleString(); document.getElementById('ch-sisa').innerText = sisa.toLocaleString();
        document.getElementById('target-pct-txt').innerText = ratio + "%"; document.getElementById('target-bar').style.width = ratio + "%";

        const ctx = document.getElementById('donutChart').getContext('2d');
        if (donutChartInstance) donutChartInstance.destroy();
        donutChartInstance = new Chart(ctx, { type: 'doughnut', data: { labels: ['Completed', 'Sisa'], datasets: [{ data: [comp, sisa], backgroundColor: ['#2563eb', '#eff6ff'], borderWidth: 0, hoverOffset: 4 }] }, options: { cutout: '80%', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: true } } } });
    }

    function extractCoords(addressStr) {
        let match = addressStr.match(/(-?\d{1,2}\.\d{3,})[,\s]+(11\d\.\d{3,})/);
        if (match) return [parseFloat(match[1]), parseFloat(match[2])];
        return null;
    }

    function addHomeMarker(pt, lat, lng) {
        let color = '#3b82f6';
        if(pt.cat === 'comp') color = '#22c55e';
        else if(pt.cat === 'op') color = '#facc15';
        else if(pt.cat === 'kp') color = '#ef4444';
        else if(pt.cat === 'kt') color = '#f97316';

        let iconHtml = `<div class="flex items-center justify-center w-6 h-6 rounded-full shadow-md border-2 border-white" style="background-color: ${color};"><i class="fa-solid fa-house text-white text-[10px]"></i></div>`;
        let customIcon = L.divIcon({ html: iconHtml, className: '', iconSize: [24, 24], iconAnchor: [12, 12] });

        L.marker([lat, lng], {icon: customIcon})
         .bindPopup(`<div class="text-xs"><b>WO:</b> ${pt.wo}<br><b>Alamat:</b> ${pt.address}<br><b>Status:</b> <span style="color:${color};font-weight:bold;">${pt.cat.toUpperCase()}</span></div>`)
         .addTo(mapInstance);
    }

    function renderMap(mapPoints) {
        if (!mapInstance) {
            mapInstance = L.map('map', {zoomControl: false}).setView([-7.2756, 112.7759], 12);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: 'OSM', subdomains: 'abcd', maxZoom: 19 }).addTo(mapInstance);
        }
        mapInstance.eachLayer((layer) => { if (layer instanceof L.Marker && !layer._url) mapInstance.removeLayer(layer); });

        geocodeQueue = [];
        document.getElementById('map-geo-indicator').classList.add('hidden');

        mapPoints.forEach(pt => {
            let coords = extractCoords(pt.address);
            if (coords) {
                addHomeMarker(pt, coords[0], coords[1]);
            } else if (geocodeCache[pt.address]) {
                if(geocodeCache[pt.address] !== 'NOT_FOUND') {
                    addHomeMarker(pt, geocodeCache[pt.address].lat, geocodeCache[pt.address].lng);
                } else {
                    addHomeMarker(pt, pt.fallbackLat, pt.fallbackLng);
                }
            } else {
                geocodeQueue.push(pt);
                addHomeMarker(pt, pt.fallbackLat, pt.fallbackLng);
            }
        });

        setTimeout(() => { mapInstance.invalidateSize(); }, 300);

        if(!isGeocoding && geocodeQueue.length > 0) {
            document.getElementById('map-geo-indicator').classList.remove('hidden');
            processGeocodeQueue();
        }
    }

    async function processGeocodeQueue() {
        if (geocodeQueue.length === 0) { 
            isGeocoding = false; 
            document.getElementById('map-geo-indicator').classList.add('hidden');
            return; 
        }
        
        isGeocoding = true;
        let pt = geocodeQueue.shift();
        
        try {
            let searchAddr = pt.address.replace(/[\n\r]+/g, ' ').trim();
            if(!searchAddr.toLowerCase().includes('surabaya')) searchAddr += ", Surabaya, Indonesia";
            else searchAddr += ", Indonesia";
            
            let response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(searchAddr)}`, { headers: { 'Accept-Language': 'id-ID' } });
            let data = await response.json();
            
            if (data && data.length > 0) {
                geocodeCache[pt.address] = { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
            } else {
                geocodeCache[pt.address] = 'NOT_FOUND';
            }
            
            localStorage.setItem('sympro_geocode_cache', JSON.stringify(geocodeCache));
            
        } catch(e) {
            geocodeQueue.unshift(pt); 
            await new Promise(r => setTimeout(r, 3000));
        }
        
        setTimeout(processGeocodeQueue, 1500);
    }

    function fetchGlobalUnassignedBadge() {
        if (typeof google === 'undefined') return;
        google.script.run.withSuccessHandler(function(res) {
            if(res && res.success && res.rows) {
                let leaderIdx = res.headers.findIndex(h => String(h).trim().toUpperCase() === 'LEADER');
                let memberIdx = res.headers.findIndex(h => String(h).trim().toUpperCase() === 'MEMBER');
                let unassignedCount = 0;
                res.rows.forEach(r => {
                    let l = leaderIdx !== -1 ? String(r[leaderIdx]).trim() : "-";
                    let m = memberIdx !== -1 ? String(r[memberIdx]).trim() : "-";
                    if (!l || l === "-" || !m || m === "-") unassignedCount++;
                });
                const badge = document.getElementById('unassigned-badge');
                if (badge) { if (unassignedCount > 0) { badge.innerText = unassignedCount; badge.classList.remove('hidden'); } else badge.classList.add('hidden'); }
            }
        }).getDailyOrderData();
    }

    function fetchMasterData() {
        if (typeof google === 'undefined') return;
        google.script.run.withSuccessHandler(function(res) { if(res.success) { techniciansCache = res.technicians; populateTechSelectOptions(); } }).getMasterTechnicians();
        google.script.run.withSuccessHandler(function(res) { if(res.success) errorCodesCache = res.errorCodes; }).getMasterErrorCodes();
    }

    function populateTechSelectOptions(editingTeamName = null) {
        const mLeader = document.getElementById('map-leader'); const mMember = document.getElementById('map-member');
        if(!mLeader || !mMember) return;
        let assignedTechs = new Set();
        mappingTimCache.forEach(m => { if(editingTeamName && m.tim === editingTeamName) return; if(m.leader) assignedTechs.add(m.leader); if(m.member) assignedTechs.add(m.member); });
        let availableTechs = techniciansCache.filter(t => !assignedTechs.has(t));
        let opts = `<option value="">-- Pilih --</option>`; availableTechs.forEach(t => { opts += `<option value="${t}">${t}</option>`; });
        mLeader.innerHTML = opts; mMember.innerHTML = opts;
    }

    function loadMappingTimData() {
        const tbody = document.getElementById('mapping-tim-body');
        if(!tbody || typeof google === 'undefined') return;
        tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-gray-400"><i class="fa-solid fa-spinner fa-spin mr-2"></i> Memuat tim...</td></tr>`;
        google.script.run.withSuccessHandler(function(res) {
            if(res.success) { mappingTimCache = res.data; renderMappingTimTable(); populateTechSelectOptions(); } 
            else tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-red-500">${res.message}</td></tr>`;
        }).getMappingTim();
    }

    function renderMappingTimTable() {
        const tbody = document.getElementById('mapping-tim-body');
        if(mappingTimCache.length === 0) { tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-gray-400">Belum ada mapping tim.</td></tr>`; return; }
        let html = "";
        mappingTimCache.forEach(item => {
            html += `<tr class="hover:bg-gray-50 transition border-b border-gray-50"><td class="py-2.5 px-4 font-bold text-gray-800">${item.tim}</td><td class="py-2.5 px-4 text-gray-600">${item.leader}</td><td class="py-2.5 px-4 text-gray-600">${item.member}</td><td class="py-2.5 px-4 text-center"><button onclick="editMappingTim('${item.tim}')" class="px-3 py-1 bg-amber-50 hover:bg-amber-100 text-amber-600 rounded-lg text-[11px] font-bold transition flex items-center gap-1 mx-auto"><i class="fa-solid fa-pen-to-square"></i> Edit</button></td></tr>`;
        });
        tbody.innerHTML = html;
    }

    function editMappingTim(timName) {
        const team = mappingTimCache.find(t => t.tim === timName); if (!team) return;
        document.getElementById('map-tim-name').value = team.tim; document.getElementById('map-form-title').innerText = "Edit Mapping Tim: " + team.tim;
        document.getElementById('btn-cancel-edit').classList.remove('hidden');
        populateTechSelectOptions(team.tim);
        setTimeout(() => { document.getElementById('map-leader').value = team.leader; document.getElementById('map-member').value = team.member; }, 50);
    }

    function resetMappingForm() {
        document.getElementById('map-tim-name').value = ""; document.getElementById('map-form-title').innerText = "Buat Mapping Baru";
        document.getElementById('btn-cancel-edit').classList.add('hidden'); populateTechSelectOptions();
    }

    function saveMappingTim() {
        const tim = document.getElementById('map-tim-name').value; const leader = document.getElementById('map-leader').value; const member = document.getElementById('map-member').value;
        if(!tim || !leader || !member) { showMessage("Lengkapi Nama Tim, Leader, dan Member!", "error"); return; }
        document.getElementById('mapping-loading').classList.remove('hidden');
        if (typeof google !== 'undefined') {
            google.script.run.withSuccessHandler(function(res) {
