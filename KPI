function getKpiProvB2CSummary() {
  try {
    const ss = SpreadsheetApp.openById(getConfig('SHEET_ID_KPI'));
    const sheet = ss.getSheetByName("DB NewSales Kpro");
    
    if (!sheet) {
      return { success: false, message: "Sheet 'DB NewSales Kpro' tidak ditemukan." };
    }
    
    const data = sheet.getDataRange().getDisplayValues();
    if (data.length <= 1) {
      return { success: false, message: "Data pada sheet DB NewSales Kpro kosong." };
    }
    
    const headers = data[0].map(h => String(h).trim().toUpperCase());
    const rows = data.slice(1);
    
    const findCol = (...keywords) => {
      return headers.findIndex(h => keywords.some(k => h === k || h.includes(k)));
    };
    
    const idxStatus     = findCol('STATUS');
    const idxErrCode    = findCol('ERRORCODE_AKHIR', 'ERRORCODE');
    const idxPeriodeIn  = findCol('PERIODE_INPUT', 'DATECREATED', 'TANGGAL INPUT');
    const idxPeriodePS  = findCol('PERIODE_PS', 'TGL_PI_AKHIR', 'STATUSDATE');
    const idxKetPI      = findCol('KETERANGAN_PI', 'STATUS_SURVEY');
    const idxTask       = findCol('STATUS_TASK', 'DESC_TASK');
    
    const now = new Date();
    const currentYear = String(now.getFullYear());
    const currentMonth = String(now.getMonth() + 1).padStart(2, '0');
    
    let stats = {
      transaksiMtd: 0,
      orderPi: 0,
      sudahIkr: 0,
      jumlahPsMtd: 0,
      kendalaMtd: 0,
      kendalaYtd: 0,
      canceledMtd: 0,
      canceledYtd: 0,
      totalAll: rows.length
    };
    
    rows.forEach(row => {
      const status   = idxStatus !== -1 ? String(row[idxStatus] || '').trim().toUpperCase() : '';
      const errCode  = idxErrCode !== -1 ? String(row[idxErrCode] || '').trim().toUpperCase() : '';
      const pInput   = idxPeriodeIn !== -1 ? String(row[idxPeriodeIn] || '').trim() : '';
      const pPS      = idxPeriodePS !== -1 ? String(row[idxPeriodePS] || '').trim() : '';
      const ketPi    = idxKetPI !== -1 ? String(row[idxKetPI] || '').trim().toUpperCase() : '';
      const task     = idxTask !== -1 ? String(row[idxTask] || '').trim().toUpperCase() : '';
      
      const isYtd = pInput.includes(currentYear) || pPS.includes(currentYear);
      const isMtd = isYtd && (pInput.includes(`-${currentMonth}-`) || pInput.includes(`/${currentMonth}/`) || pPS.includes(`-${currentMonth}-`) || pPS.includes(`/${currentMonth}/`));
      
      if (isMtd || !pInput) {
        stats.transaksiMtd++;
      }
      
      if (!status.includes('COMPLETED') && !status.includes('PS') && !status.includes('CANCEL') && !status.includes('REVOKE')) {
        stats.orderPi++;
      }
      
      if (task.includes('IKR') || task.includes('INSTAL') || ketPi.includes('IKR') || status.includes('READY')) {
        stats.sudahIkr++;
      }
      
      if (status.includes('PS') || status.includes('COMPLETED') || status === 'SUCCESS') {
        if (isMtd || !pPS) {
          stats.jumlahPsMtd++;
        }
      }
      
      if (errCode !== '' || status.includes('KENDALA') || status.includes('HOLD') || status.includes('PENDING')) {
        if (isYtd || !pInput) stats.kendalaYtd++;
        if (isMtd || !pInput) stats.kendalaMtd++;
      }
      
      if (status.includes('CANCEL') || status.includes('REVOKE') || status.includes('BATAL')) {
        if (isYtd || !pInput) stats.canceledYtd++;
        if (isMtd || !pInput) stats.canceledMtd++;
      }
    });
    
    return { success: true, data: stats };
  } catch (e) {
    return { success: false, message: "Error sistem: " + e.message };
  }
}
