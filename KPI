function getKpiDataByName(sheetName) {
  try {
    const sheet = SpreadsheetApp.openById(getConfig('SHEET_ID_KPI')).getSheetByName(sheetName);
    if (!sheet) return { success: false, message: "Sheet '" + sheetName + "' tidak ditemukan di Spreadsheet KPI." };
    
    const data = sheet.getDataRange().getValues();
    if (!data || data.length <= 1) {
      const headers = (data && data.length > 0) ? data[0] : [];
      return { success: true, headers: headers, rows: [] };
    }
    
    const headers = data[0];
    const rows = data.slice(1);
    
    return { success: true, headers: headers, rows: rows };
  } catch(e) {
    return { success: false, message: e.message };
  }
}

function getKpiAssB2CData() { return getKpiDataByName("Close Tiket"); }
function getResultSqmData() { return getKpiDataByName("Close SQM"); }

