            }
            if(res.success) {
                dbTodoTasks = res.data || [];
                renderToDoList();
            } else {
                showMessage("Gagal memuat tugas: " + res.message, "error");
            }
        })
        .withFailureHandler(function(err) {
            if (!isSilent) {
                const lEl = document.getElementById('todo-loading');
                if(lEl) lEl.classList.add('hidden');
            }
            showMessage("Sistem Error: " + err.message, "error");
        })
        .getToDoList();
    }

    function renderToDoList() {
        const dailyContainer = document.getElementById('notion-daily-container');
        const weeklyContainer = document.getElementById('notion-weekly-container');
        if(!dailyContainer || !weeklyContainer) return;

        const myName = localStorage.getItem("sym_pro_user") || "";
        const myRole = localStorage.getItem("sym_pro_role") || "user";
        
        let visibleTasks = dbTodoTasks;
        if (myRole.toLowerCase() !== 'superadmin') {
            visibleTasks = dbTodoTasks.filter(t => t.assignee === myName || t.assignee === "" || !t.assignee);
        }

        const dailyTasks = visibleTasks.filter(t => t.type === 'Daily');
        const weeklyTasks = visibleTasks.filter(t => t.type === 'Weekly');
        
        let dCompleted = 0; let wCompleted = 0;

        let dailyHtml = generateNotionRowsHtml(dailyTasks, 'Daily');
        dailyContainer.innerHTML = dailyHtml.html;
        dCompleted = dailyHtml.completed;

        let weeklyHtml = generateNotionRowsHtml(weeklyTasks, 'Weekly');
        weeklyContainer.innerHTML = weeklyHtml.html;
        wCompleted = weeklyHtml.completed;

        const totalTasks = dailyTasks.length + weeklyTasks.length;
        const totalCompleted = dCompleted + wCompleted;
        const pct = totalTasks === 0 ? 0 : Math.round((totalCompleted / totalTasks) * 100);
        const pTxt = document.getElementById('todo-progress-text');
        const pBar = document.getElementById('todo-progress-bar');
        if(pTxt) pTxt.innerText = `${pct}% completed overall`;
        if(pBar) pBar.style.width = `${pct}%`;
        
        const wGoal = document.getElementById('weekly-goal-text');
        if(wGoal) wGoal.innerText = `${wCompleted} / 5`;
    }

    function generateNotionRowsHtml(tasksArray, type) {
        if (tasksArray.length === 0) return { html: `<div class="p-4 text-center text-xs text-gray-400 italic">Belum ada task ${type}.</div>`, completed: 0 };
        
        let html = ''; let completedCount = 0;
        
        const grouped = {
            'To Do': tasksArray.filter(t => t.status === 'To Do'),
            'In Progress': tasksArray.filter(t => t.status === 'In Progress'),
            'Done': tasksArray.filter(t => t.status === 'Done')
        };

        Object.keys(grouped).forEach(statusGroup => {
            const tasksInGroup = grouped[statusGroup];
            if(tasksInGroup.length === 0) return;
            
            let groupIcon = '<i class="fa-regular fa-circle text-gray-400"></i>';
            if (statusGroup === 'In Progress') groupIcon = '<i class="fa-solid fa-circle-half-stroke text-blue-500"></i>';
            if (statusGroup === 'Done') groupIcon = '<i class="fa-solid fa-circle-check text-green-500"></i>';

            html += `<div class="mb-4">
                <div class="flex items-center gap-2 mb-1 px-2 text-xs font-bold text-gray-600">
                    <span class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-gray-50 border border-gray-100">${groupIcon} ${statusGroup} <span class="text-gray-400 ml-1">${tasksInGroup.length}</span></span>
                </div>`;

            tasksInGroup.forEach(task => {
                const isChecked = task.status === 'Done';
                if(isChecked) completedCount++;
                const checkClass = isChecked ? 'checked' : '';
                const textClass = isChecked ? 'completed' : 'text-gray-800 font-medium';
                
                let priorityClass = 'tag-default';
                if(task.priority === 'High') priorityClass = 'tag-red';
                else if(task.priority === 'Medium') priorityClass = 'tag-yellow';
                else if(task.priority === 'Low') priorityClass = 'tag-blue';
                
                let assignText = task.assignee || "Umum";

                html += `
                    <div class="notion-row flex items-center px-4 py-2.5 text-[11px]">
                        <div class="flex items-center gap-3 flex-1 min-w-[200px]">
                            <div class="notion-checkbox ${checkClass} shrink-0" onclick="toggleTaskStatus('${task.id}', '${task.status}',${task.originalIndex})"></div>
                            <span class="task-title ${textClass} select-none cursor-pointer flex-1 py-0.5 leading-tight hover:underline" onclick="openTaskModal('${task.id}')">${task.title}</span>
                        </div>
                        
                        <div class="w-32 hidden md:flex items-center gap-1.5 text-gray-500">
                            <div class="w-4 h-4 rounded-full bg-gray-200 flex items-center justify-center text-[8px] font-bold text-gray-600"><i class="fa-regular fa-user"></i></div>
                            <span class="truncate">${assignText}</span>
                        </div>
                        
                        <div class="w-28 hidden sm:block">
                            <span class="notion-tag tag-default cursor-pointer hover:bg-gray-200" onclick="openTaskModal('${task.id}')"><i class="fa-regular fa-circle-dot"></i> ${task.status}</span>
                        </div>
                        
                        <div class="w-28 hidden sm:block">
                            <span class="notion-tag ${priorityClass}">${task.priority}</span>
                        </div>

                        <div class="w-32 text-right text-gray-400 font-medium whitespace-nowrap">
                            ${task.time || '-'}
                        </div>
                    </div>
                `;
            });
            html += `</div>`;
        });
        return { html: html, completed: completedCount };
    }

