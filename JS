    window.dashFilteredData = { total: {all:[], create:[], migrate:[], modify:[]}, kp: {all:[], create:[], migrate:[], modify:[]}, kt: {all:[], create:[], migrate:[], modify:[]}, op: {all:[], create:[], migrate:[], modify:[]}, comp: {all:[], create:[], migrate:[], modify:[]} };

    function getCacheKeyForMode(mode) {
        if (mode === 'daily-order' || mode === 'order-hi' || mode === 'daily-report') return 'list-daily-order';
        if (mode === 'order-kendala') return 'order-kendala';
        if (mode === 'order-completed') return 'order-completed'; return mode;
    }

    let currentSortCol = null; let currentSortDir = 'asc';

    function applyRoleAccess(role) {
        const roleLower = String(role).toLowerCase(); 
        const manageUserMenu = document.getElementById('menu-manage-user');
        const btnNewTask = document.getElementById('btn-new-task');
        const acMenu = document.getElementById('menu-access-control');

        if (roleLower === 'superadmin') {
            if(acMenu) acMenu.classList.remove('hidden');

            if(manageUserMenu) { 
                manageUserMenu.classList.remove('hidden'); 
                manageUserMenu.classList.add('block'); 
            }
            if(btnNewTask) btnNewTask.classList.remove('hidden');
        } else { 
            if(acMenu) acMenu.classList.add('hidden'); // Sembunyikan menu AC jika bukan superadmin

            if(manageUserMenu) { 
                manageUserMenu.classList.add('hidden'); 
                manageUserMenu.classList.remove('block'); 
            }
            if(btnNewTask) btnNewTask.classList.add('hidden');
        }
    }

    window.onload = function() {
        const savedUser = localStorage.getItem("sym_pro_user"); const savedRole = localStorage.getItem("sym_pro_role");

        const today = new Date(); const dateString = today.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
        const elDateRange = document.getElementById('dash-date-range');
        if (elDateRange) elDateRange.innerText = dateString + " - " + dateString;

        if (savedUser) {
            document.getElementById('auth-bg').style.display = 'none'; document.getElementById('auth-card-container').style.display = 'none';
            document.getElementById('dashboard-wrapper').classList.remove('hidden');
            document.getElementById('user-role-badge').innerText = "Role: " + (savedRole || "USER").toUpperCase();
            applyRoleAccess(savedRole || "user"); switchMenu('daily-report'); loadRecentImports();
        }
        fetchMasterData(); loadMappingTimData(); fetchGlobalUnassignedBadge();
        
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('follow-up-menu');
            const btn = document.getElementById('btn-follow-up');
            if (menu && !menu.classList.contains('hidden') && !menu.contains(event.target) && event.target !== btn && (!btn || !btn.contains(event.target))) {
                menu.classList.add('hidden');
            }
        });
    };

    function loadKpiDashboard(menuName) {
        if (typeof google === 'undefined') return;

        const assContent  = document.getElementById('dashboard-ass-b2c-content');
        const provContent = document.getElementById('dashboard-prov-b2c-content');
        const titleEl     = document.getElementById('dashboard-empty-title');

        if (assContent)  assContent.classList.add('hidden');
        if (provContent) provContent.classList.add('hidden');
        if (titleEl)     titleEl.classList.add('hidden');

        if (menuName === 'dashboard-b2c') {
            if (assContent) assContent.classList.remove('hidden');
            showMessage("Mengambil data rekap KPI Ass B2C dari Spreadsheet...", "success");
            
            google.script.run
            .withSuccessHandler(function(res) {
                if (res && res.success) {
                    showMessage("Data KPI Ass B2C berhasil diperbarui!", "success");
                    renderKpiAssB2CDirect(res.data);
                } else {
                    showMessage("Gagal: " + (res ? res.message : "Error server"), "error");
                }
            })
            .withFailureHandler(function(err) {
                showMessage("Error Server: " + err.message, "error");
            })
            .getKpiAssB2CSummary();
        } 
        else if (menuName === 'dashboard-prov-b2c') {
            if (provContent) provContent.classList.remove('hidden');
            showMessage("Mengambil data KPI Prov B2C (DB NewSales Kpro)...", "success");
            
            google.script.run
            .withSuccessHandler(function(res) {
                if (res && res.success) {
                    showMessage("Data KPI Prov B2C berhasil diperbarui!", "success");
                    renderKpiProvB2CDirect(res.data);
                } else {
                    showMessage("Gagal: " + (res ? res.message : "Error server"), "error");
                }
            })
            .withFailureHandler(function(err) {
                showMessage("Error Server: " + err.message, "error");
            })
            .getKpiProvB2CSummary();
        }
        else if (menuName === 'dashboard-sqm') {
            if (titleEl) {
                titleEl.innerText = "Dasboard Result SQM (Menunggu Penyusunan)";
                titleEl.classList.remove('hidden');
            }
        }
    }

