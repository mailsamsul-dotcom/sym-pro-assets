        setTxt('ass-sa-open',     Number(d.sa.open || 0).toLocaleString('id-ID'));
        setTxt('ass-sa-dia-fsk',  d.sa.diaFsk);  setTxt('ass-sa-dia-lgc',  d.sa.diaLgc);
        setTxt('ass-sa-plat-fsk', d.sa.platFsk); setTxt('ass-sa-plat-lgc', d.sa.platLgc);
        setTxt('ass-sa-gold-fsk', d.sa.goldFsk); setTxt('ass-sa-gold-lgc', d.sa.goldLgc);
        setTxt('ass-sa-reg-fsk',  d.sa.regFsk);  setTxt('ass-sa-reg-lgc',  d.sa.regLgc);
        setTxt('ass-sa-gamas',    d.sa.gamas);   setTxt('ass-sa-nongamas', d.sa.nongamas);
        
        let saRealVal = Number(d.sa.real || 0);
        let saAchVal  = Number(d.sa.ach || 0);
        setTxt('ass-sa-real', (saRealVal > 1 ? saRealVal : saRealVal * 100).toFixed(2) + "%");
        
        const elSaAch = document.getElementById('ass-sa-ach');
        if (elSaAch) {
            let achDisplay = saAchVal > 1 ? saAchVal : saAchVal * 100;
            elSaAch.innerText = achDisplay.toFixed(0) + "%";
            elSaAch.className = achDisplay >= 100 ? "text-xl font-black text-emerald-600" : "text-xl font-black text-rose-600";
