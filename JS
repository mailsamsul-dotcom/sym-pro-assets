                    let displayMemo = item.memo ? `<div class="mt-2.5 pt-2.5 border-t border-gray-100 text-[10px] text-gray-500 font-medium leading-snug line-clamp-3" title="${safeMemo}"><i class="fa-solid fa-comment-dots text-gray-400 mr-1.5"></i>${item.memo}</div>` : "";
                    
                    html += `
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 cursor-grab active:cursor-grabbing hover:border-blue-400 hover:shadow-md transition-all group"
                         draggable="true" 
                         onclick="openDetailModalByWo('${safeWo}')"
                         ondragstart="drag(event, '${safeKey}', '${safeWo}', '${safeTsel}', '${colKey}')">
                        <div class="flex items-start justify-between mb-1">
                            <span class="text-xs font-black text-blue-700 group-hover:text-blue-800 break-all leading-tight">${displayId}</span>
                            <div class="flex items-center gap-1 shrink-0">
                                <button onclick="event.stopPropagation(); openKanbanUpdateOnly('${safeKey}', '${safeWo}', '${safeTsel}', '${colKey}')" title="Update Progres" class="text-amber-500 hover:text-amber-600 transition p-1"><i class="fa-solid fa-pen-to-square"></i></button>
                                <button onclick="event.stopPropagation(); viewKanbanHistory('${safeKey}')" title="Lihat History" class="text-gray-400 hover:text-blue-600 transition p-1"><i class="fa-solid fa-clock-rotate-left"></i></button>
                            </div>
                        </div>
                        <div class="text-[11px] font-bold text-gray-800 mb-2.5 leading-tight pointer-events-none">${item.cust}</div>
                        <div class="flex flex-wrap items-center gap-2 mb-2.5 pointer-events-none">
                            <span class="bg-orange-50 text-orange-600 border border-orange-100 px-2 py-0.5 rounded text-[9px] font-bold shadow-xs max-w-full"><i class="fa-solid fa-triangle-exclamation mr-1"></i>${item.suberr}</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-[10px] text-gray-500 font-semibold bg-gray-50 p-1.5 rounded-lg border border-gray-100 pointer-events-none">
                            <div class="w-5 h-5 rounded-full bg-white shadow-xs text-gray-400 flex items-center justify-center shrink-0"><i class="fa-solid fa-user-tie text-[9px]"></i></div>
                            <span class="truncate">${item.leader}</span>
                        </div>
                        ${displayMemo}
                    </div>`;
                });
                html += `</div></div>`;
            });
            container.innerHTML = html;
        } catch (e) {
            console.error(e);
            container.innerHTML = `<div class="text-red-500 p-4">Error Rendering Board: ${e.message}</div>`;
        }
    }

    let pendingKanbanUpdate = null; 

    function drag(ev, key, wo, tsel, currentStatus) {
        ev.dataTransfer.setData("key", key);
        ev.dataTransfer.setData("wo", wo);
        ev.dataTransfer.setData("tsel", tsel);
        ev.dataTransfer.setData("currentStatus", currentStatus);
        ev.dataTransfer.effectAllowed = "move";
    }
    
    function allowDrop(ev, colKey) {
        const role = (localStorage.getItem("sym_pro_role") || "").toLowerCase();
        const permissions = {
            'superadmin': ['OPEN', 'PROGRESS', 'FINISH_INSTALL', 'VALID_4', 'COMPLETED', 'DROP'],
            'admin': ['VALID_4', 'COMPLETED'],
            'korlap': ['PROGRESS', 'FINISH_INSTALL', 'COMPLETED']
        };
        const allowedLanes = permissions[role] || [];
        
        if (role === 'superadmin' || allowedLanes.includes(colKey)) {
            ev.preventDefault(); 
            ev.dataTransfer.dropEffect = "move";
        }
    }
    
    function drop(ev, colKey, title) {
        ev.preventDefault();
        const key = ev.dataTransfer.getData("key");
        const wo = ev.dataTransfer.getData("wo");
        const tsel = ev.dataTransfer.getData("tsel");
        const currentStatus = ev.dataTransfer.getData("currentStatus");
        
        pendingKanbanUpdate = { key, wo, tsel, newStatus: colKey, currentStatus, title };
        
        const titleEl = document.getElementById('kanban-update-title');
        const modalEl = document.getElementById('kanban-update-modal');
        const noteEl = document.getElementById('kanban-update-note');

        if(titleEl && modalEl && noteEl) {
            titleEl.innerHTML = `<i class="fa-solid fa-truck-fast text-blue-500"></i> Pindah ke: ${title}`;
            noteEl.value = "";
            modalEl.classList.remove('hidden');
        }
    }

    function openKanbanUpdateOnly(key, wo, tsel, currentStatus) {
        pendingKanbanUpdate = { key, wo, tsel, newStatus: currentStatus, currentStatus, title: currentStatus };
        
        const titleEl = document.getElementById('kanban-update-title');
        const modalEl = document.getElementById('kanban-update-modal');
        const noteEl = document.getElementById('kanban-update-note');

        if(titleEl && modalEl && noteEl) {
            titleEl.innerHTML = `<i class="fa-solid fa-pen-to-square text-amber-500"></i> Update Pekerjaan`;
            noteEl.value = "";
            modalEl.classList.remove('hidden');
        }
    }

    function confirmKanbanUpdate() {
        const noteEl = document.getElementById('kanban-update-note');
        const note = noteEl ? noteEl.value : "";
        
        if (!note.trim()) {
            showMessage("Silakan isi update progres pekerjaan terlebih dahulu!", "error");
            return;
        }

        const modalEl = document.getElementById('kanban-update-modal');
        if (modalEl) modalEl.classList.add('hidden');
        
        updateKanbanBackend(
            pendingKanbanUpdate.key, 
            pendingKanbanUpdate.wo, 
            pendingKanbanUpdate.tsel, 
            pendingKanbanUpdate.newStatus, 
            note
        );
    }

    function updateKanbanBackend(key, wo, tsel, newStatus, note) {
        const user = localStorage.getItem("sym_pro_user") || "Unknown User";
        const now = new Date();
        const timestamp = now.toLocaleDateString('id-ID', {day: '2-digit', month: '2-digit', year: 'numeric'}) + ' ' + String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');

        const loading = document.getElementById('board-loading');
        const container = document.getElementById('kanban-container');

        if (loading) loading.classList.remove('hidden');
        if (container) container.innerHTML = '';

        if (typeof google === 'undefined') return;

        google.script.run.withSuccessHandler(function(res) {
            if(res.success) { showMessage(res.message, "success"); } 
            else { showMessage(res.message, "error"); }
            loadBoardKendalaData(); 
        }).updateKanbanBoard({
            trackId: tsel, workorder: wo, newStatus: newStatus, user: user, timestamp: timestamp, note: note
        });
    }

    function viewKanbanHistory(key) {
        let cleanKey = String(key).trim();
        let history = window.kanbanHistories[cleanKey] || "";
        let content = document.getElementById('kanban-history-content');
        const modal = document.getElementById('kanban-history-modal');
        
        if (!content || !modal) return;

        if(!history || history === "undefined") {
            content.innerHTML = `<div class="text-center py-8 text-gray-400 font-medium italic">Belum ada history update.</div>`;
        } else {
            let logs = history.split(/\n\s*\n/); 
            let html = `<div class="space-y-4">`;
            
            logs.forEach(log => {
                let lines = log.split("\n");
                let headerLine = lines[0];
                let noteLine = lines.length > 1 ? lines.slice(1).join("<br>") : "";

                let match = headerLine.match(/\[(.*?)\] (.*)/);
                if(match) {
                    let noteHtml = noteLine ? `<div class="mt-2 pt-2 border-t border-gray-100 text-slate-600 italic bg-amber-50/50 p-2 rounded-lg text-[10px]">${noteLine.replace('📝 Update: ', '')}</div>` : "";
                    html += `
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center shrink-0 border border-blue-200 shadow-sm mt-0.5"><i class="fa-solid fa-clock-rotate-left text-[10px]"></i></div>
                        <div class="bg-white p-3.5 rounded-xl border border-gray-200 shadow-sm flex-1">
                            <div class="font-black text-slate-800 text-[10px] border-b border-gray-100 pb-1 mb-1">${match[1]}</div>
                            <div class="text-slate-700 font-bold text-[11px] leading-snug">${match[2]}</div>
                            ${noteHtml}
                        </div>
                    </div>`;
                }
            });
            html += `</div>`;
            content.innerHTML = html;
        }
        modal.classList.remove('hidden');
    }

    function openDetailModalByWo(wo) {
        const idx = globalDailyRows.findIndex(r => String(r[globalDailyHeaders.findIndex(h => String(h).toLowerCase().includes('workorder'))]).trim() === wo);
        if (idx !== -1) {
            openDetailModal(idx);
        } else {
            showMessage("Data detail tidak ditemukan.", "error");
        }
    }

    function loadAccessControlData() {
        google.script.run.withSuccessHandler(function(data) {
            const container = document.getElementById('config-form');
            let html = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';
            data.forEach((row, i) => {
                html += `<div>
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">${row[0]}</label>
                    <input type="text" class="config-input w-full border border-gray-200 rounded-lg px-3 py-2 text-xs" data-key="${row[0]}" value="${row[1]}">
                </div>`;
            });
            html += `</div><button onclick="saveConfigs()" class="mt-6 px-6 py-2 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700">Simpan Perubahan</button>`;
            container.innerHTML = html;
        }).getAllConfigs();
    }

    function saveConfigs() {
        let inputs = document.querySelectorAll('.config-input');
        let newConfigs = [];
        inputs.forEach(input => {
            newConfigs.push([input.dataset.key, input.value]);
        });
        
        google.script.run.withSuccessHandler(function(res) {
            showMessage(res.message, res.success ? "success" : "error");
        }).saveAllConfigs(newConfigs);
    }

    function closeAllDropdowns() {
        const dropdowns = document.querySelectorAll('.dropdown-menu');
        dropdowns.forEach(d => d.classList.add('hidden'));
    }
</script>
