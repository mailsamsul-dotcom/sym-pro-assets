        const id = document.getElementById('todo-input-id').value;
        const rowIdx = document.getElementById('todo-input-row').value;
        const title = document.getElementById('todo-input-title').value;
        
        if(!title) { showMessage("Judul task tidak boleh kosong!", "error"); return; }
        
        const payload = {
            action: id ? 'edit' : 'new',
            id: id,
            originalIndex: rowIdx,
            title: title,
            type: document.getElementById('todo-input-type').value,
            time: document.getElementById('todo-input-time').value,
            status: document.getElementById('todo-input-status').value,
