        setTxt('ass-ag-open',     Number(d.ag.open || 0).toLocaleString('id-ID'));
        setTxt('ass-ag-dia-fsk',  d.ag.diaFsk);  setTxt('ass-ag-dia-lgc',  d.ag.diaLgc);
