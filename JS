        setTxt('ass-ag-gold-fsk', d.ag.goldFsk); setTxt('ass-ag-gold-lgc', d.ag.goldLgc);
        setTxt('ass-ag-reg-fsk',  d.ag.regFsk);  setTxt('ass-ag-reg-lgc',  d.ag.regLgc);
