    function loadBoardKendalaData(forceRefresh = false) {
        try {
            const container = document.getElementById('kanban-container');
            const loading = document.getElementById('board-loading');
            
            if (container) container.innerHTML = '';
            if (loading) loading.classList.remove('hidden');

            if (typeof google === 'undefined') return;

            google.script.run.withSuccessHandler(function(res) {
                if (loading) loading.classList.add('hidden');
                if(!res || !res.success) { showMessage("Gagal memuat Board: " + (res ? res.message : ''), "error"); return; }
                
                boardKendalaHeaders = res.headers || [];
                let allRows = res.rows || [];

                let errIdx = boardKendalaHeaders.findIndex(h => String(h || "").trim().toUpperCase() === 'ERRORCODE');
                let subErrIdx = boardKendalaHeaders.findIndex(h => String(h || "").trim().toUpperCase() === 'SUBERRORCODE');

                boardKendalaRows = allRows.filter(row => {
                    let errVal = errIdx !== -1 ? String(row[errIdx] || "").trim().toUpperCase() : "";
                    return errVal.includes("KENDALA TEKNIK") || errVal.includes("JARINGAN");
                });

                let uniqueSubErrs = new Set();
                boardKendalaRows.forEach(row => {
                    let subVal = subErrIdx !== -1 ? String(row[subErrIdx] || "").trim() : "";
                    if (subVal && subVal !== "-") uniqueSubErrs.add(subVal);
                });

                let subErrSelect = document.getElementById('board-filter-suberr');
                if (subErrSelect) {
                    let opts = `<option value="">Semua Sub Error Code</option>`;
                    Array.from(uniqueSubErrs).sort().forEach(val => { opts += `<option value="${val}">${val}</option>`; });
                    subErrSelect.innerHTML = opts;
                }

                applyBoardFilters();

            }).withFailureHandler(function(err) {
                if (document.getElementById('board-loading')) document.getElementById('board-loading').classList.add('hidden');
                showMessage("Error Server: " + err.message, "error");
            }).getOrderKendalaData();
        } catch (e) {
            document.getElementById('kanban-container').innerHTML = `<div class="p-5 text-red-500 font-bold w-full text-center">Error load data: ${e.message}</div>`;
        }
    }

    function applyBoardFilters() {
        try {
            const elSearch = document.getElementById('board-search');
            const elSubErr = document.getElementById('board-filter-suberr');
            const elStart = document.getElementById('board-start-date');
            const elEnd = document.getElementById('board-end-date');

            const searchQ = elSearch ? elSearch.value.toLowerCase().trim() : "";
            const subErrFilter = elSubErr ? elSubErr.value.toLowerCase() : "";
            const startDateStr = elStart ? elStart.value : ""; 
            const endDateStr = elEnd ? elEnd.value : ""; 

            let startObj = startDateStr ? new Date(startDateStr) : null;
            let endObj = endDateStr ? new Date(endDateStr) : null;
            if (startObj) startObj.setHours(0,0,0,0);
            if (endObj) endObj.setHours(23,59,59,999);

            let woIdx = boardKendalaHeaders.findIndex(h => String(h || "").trim().toUpperCase().includes('WORKORDER'));
            let trackIdx = boardKendalaHeaders.findIndex(h => { let hc = String(h || "").trim().toUpperCase(); return hc === 'ORDER ID TSEL' || hc.includes('SC ORDER NO') || hc.includes('CSRM'); });
            let subErrIdx = boardKendalaHeaders.findIndex(h => String(h || "").trim().toUpperCase() === 'SUBERRORCODE');
            let recordDateIdx = boardKendalaHeaders.findIndex(h => String(h || "").trim().toUpperCase() === 'RECORD_DATE');
            let dateCreatedIdx = boardKendalaHeaders.findIndex(h => String(h || "").trim().toUpperCase() === 'DATE CREATED');
            
            let filtered = boardKendalaRows.filter(row => {
                let woVal = woIdx !== -1 ? String(row[woIdx] || "").toLowerCase() : "";
                let tVal = trackIdx !== -1 ? String(row[trackIdx] || "").toLowerCase() : "";
                let subVal = subErrIdx !== -1 ? String(row[subErrIdx] || "").toLowerCase() : "";

                if (searchQ && !(woVal.includes(searchQ) || tVal.includes(searchQ))) return false;
                if (subErrFilter && subVal !== subErrFilter) return false;

                let dateVal = recordDateIdx !== -1 ? String(row[recordDateIdx] || "").trim() : "";
                if (!dateVal && dateCreatedIdx !== -1) dateVal = String(row[dateCreatedIdx] || "").trim();

                if (startObj || endObj) {
                    if (!dateVal) return false; 
                    let rowDateObj = null;
                    if (dateVal.includes("/")) {
                        let cleanDate = dateVal.split(" ")[0].replace(/,/g, '');
                        let parts = cleanDate.split("/");
                        if (parts.length === 3) rowDateObj = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                    } else {
                        rowDateObj = new Date(dateVal);
                    }
                    if (rowDateObj && !isNaN(rowDateObj.getTime())) {
                        if (startObj && rowDateObj < startObj) return false;
                        if (endObj && rowDateObj > endObj) return false;
                    }
                }
                return true;
            });

            renderKanbanBoard(filtered);
        } catch(e) {
            document.getElementById('kanban-container').innerHTML = `<div class="p-5 text-red-500 font-bold w-full text-center">Error saat filter: ${e.message}</div>`;
        }
    }

