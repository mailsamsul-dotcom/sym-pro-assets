                btn.innerHTML = 'Save Task'; btn.disabled = false;
                if(res.success) {
                    showMessage(res.message, "success");
                    closeToDoModal();
                    
                    if (payload.action === 'new') {
                        payload.id = res.newId;
                        payload.originalIndex = dbTodoTasks.length > 0 ? Math.max(...dbTodoTasks.map(t => t.originalIndex || 0)) + 1 : 2;
                        dbTodoTasks.push(payload);
                    } else {
                        const idx = dbTodoTasks.findIndex(t => String(t.id) === String(payload.id));
                        if (idx > -1) {
                            dbTodoTasks[idx] = { ...dbTodoTasks[idx], ...payload };
                        }
                    }
