        const setNum = (id, val) => {
            const el = document.getElementById(id);
            if (el) el.innerText = Number(val || 0).toLocaleString('id-ID');
        };

        setNum('prov-transaksi-mtd', d.transaksiMtd);
        setNum('prov-order-pi',      d.orderPi);
        setNum('prov-sudah-ikr',     d.sudahIkr);
        setNum('prov-jumlah-ps-mtd', d.jumlahPsMtd);
        setNum('prov-kendala-mtd',   d.kendalaMtd);
        setNum('prov-kendala-ytd',   d.kendalaYtd);
        setNum('prov-canceled-mtd',  d.canceledMtd);
        setNum('prov-canceled-ytd',  d.canceledYtd);
