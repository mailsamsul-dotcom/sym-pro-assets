// Utils.gs
function getMasterTechnicians() {
  try {
    const sheet = SpreadsheetApp.openById(getConfig('SHEET_ID')).getSheetByName("Master Teknisi");
    if (!sheet) return { success: false, technicians: [] };
    const data = sheet.getDataRange().getValues();
    let techs = [];
    for (let i = 1; i < data.length; i++) {
      let nama = String(data[i][0]).trim();
      if (nama) techs.push(nama);
    }
    return { success: true, technicians: [...new Set(techs)] };
  } catch (err) {
    return { success: false, technicians: [] };
  }
}

function getMasterErrorCodes() {
  try {
    const sheet = SpreadsheetApp.openById(getConfig('SHEET_ID')).getSheetByName("Master Error Code");
    if (!sheet) return { success: false, errorCodes: [] };
    const data = sheet.getDataRange().getValues();
    let list = [];
    for (let i = 1; i < data.length; i++) {
      let err = String(data[i][0]).trim();
      let sub = String(data[i][1]).trim();
      if (err || sub) {
        list.push({ errorCode: err, subErrorCode: sub });
      }
    }
    return { success: true, errorCodes: list };
  } catch (err) {
    return { success: false, errorCodes: [] };
  }
}

function getMappingTim() {
  try {
    const ss = SpreadsheetApp.openById(getConfig('SHEET_ID'));
    let sheet = ss.getSheetByName("Mapping Tim");
    if (!sheet) {
      sheet = ss.insertSheet("Mapping Tim");
      sheet.appendRow(["Nama Tim", "Leader", "Member", "Last Updated"]);
      return { success: true, data: [] };
    }
    
    const data = sheet.getDataRange().getValues();
    let mapping = [];
    for (let i = 1; i < data.length; i++) {
      if (data[i][0]) {
        mapping.push({
          tim: String(data[i][0]).trim(),
          leader: String(data[i][1]).trim(),
          member: String(data[i][2]).trim()
        });
      }
    }
    return { success: true, data: mapping };
  } catch(e) {
    return { success: false, message: e.message, data: [] };
  }
}

function saveMappingTim(timName, leader, member) {
  try {
    const ss = SpreadsheetApp.openById(getConfig('SHEET_ID'));
    let sheet = ss.getSheetByName("Mapping Tim");
    if (!sheet) sheet = ss.insertSheet("Mapping Tim");

    const data = sheet.getDataRange().getValues();
    let isUpdate = false;
    
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][0]).trim() === timName.trim()) {
        sheet.getRange(i + 1, 2).setValue(leader);
        sheet.getRange(i + 1, 3).setValue(member);
        sheet.getRange(i + 1, 4).setValue(new Date());
        isUpdate = true;
        break;
      }
    }

    if (!isUpdate) {
      sheet.appendRow([timName, leader, member, new Date()]);
    }
    
    return { success: true, message: "Mapping Tim berhasil disimpan!" };
  } catch(e) {
    return { success: false, message: "Error: " + e.message };
  }
}

function deleteMappingTim(timName) {
  try {
    const sheet = SpreadsheetApp.openById(getConfig('SHEET_ID')).getSheetByName("Mapping Tim");
    if (!sheet) return { success: false, message: "Sheet tidak ditemukan" };
    
    const data = sheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][0]).trim() === timName.trim()) {
        sheet.deleteRow(i + 1);
        return { success: true, message: `Tim ${timName} berhasil dihapus!` };
      }
    }
    return { success: false, message: "Tim tidak ditemukan" };
  } catch(e) {
    return { success: false, message: e.message };
  }
}

function deleteAllMappingTim() {
  try {
    const sheet = SpreadsheetApp.openById(getConfig('SHEET_ID')).getSheetByName("Mapping Tim");
    if (!sheet) return { success: false, message: "Sheet Mapping Tim tidak ditemukan" };
    
    const lastRow = sheet.getLastRow();
    if (lastRow > 1) {
      sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).clearContent();
    }
    return { success: true, message: "Seluruh Daftar Tim Aktif berhasil dihapus!" };
  } catch(e) {
    return { success: false, message: "Gagal menghapus: " + e.message };
  }
}

function getSheetDataByName(sheetName) {
  try {
    const sheet = SpreadsheetApp.openById(getConfig('SHEET_ID')).getSheetByName(sheetName);
    if (!sheet) return { success: false, message: "Sheet '" + sheetName + "' tidak ditemukan." };
    
    const data = sheet.getDataRange().getValues();
    if (!data || data.length <= 1) {
      const headers = (data && data.length > 0) ? data[0] : [];
      return { success: true, headers: headers, rows: [] };
    }
    
    const headers = data[0];
    const rows = [];
    
    for (let i = 1; i < data.length; i++) {
      let row = data[i];
      let hasContent = row.some(cell => cell !== undefined && cell !== null && String(cell).trim() !== "");
      
      if (hasContent) {
        let rowStr = row.join(" ").toUpperCase();
        let isHeaderFormulaRow = rowStr.includes("WORKORDER") && rowStr.includes("CUSTOMER");
        
        if (!isHeaderFormulaRow) {
          let cleanRow = row.map(cell => {
            if (cell instanceof Date) {
              return cell.toLocaleString('id-ID');
            }
            return cell !== undefined && cell !== null ? String(cell) : "";
          });
          rows.push(cleanRow);
        }
      }
    }

    return { success: true, headers: headers, rows: rows };
  } catch(e) {
    return { success: false, message: e.message };
  }
}
