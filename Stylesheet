<style>
    body { font-family: 'Poppins', sans-serif; background-color: #f8fafc; overflow-x: hidden; }

    /* --- STYLES LOGIN & GENERAL --- */
    .input-group { position: relative; margin-bottom: 1rem; }
    .input-group label { display: block; font-size: 11px; font-weight: 700; margin-bottom: 6px; color: #1e293b; }
    .input-field { width: 100%; padding: 12px 14px 12px 45px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 12px; color: #334155; outline: none; transition: all 0.2s ease-in-out; background-color: #ffffff; }
    .input-field:focus { border-color: #1d4ed8; box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1); }
    .icon-left { position: absolute; left: 18px; top: 35px; color: #64748b; font-size: 13px; pointer-events: none; }
    .icon-right { position: absolute; right: 16px; top: 35px; color: #64748b; font-size: 13px; cursor: pointer; transition: color 0.2s; }
    .social-btn { display: flex; align-items: center; justify-content: center; gap: 8px; flex: 1; padding: 10px; border: 1px solid #e2e8f0; border-radius: 10px; background: white; font-size: 12px; font-weight: 600; color: #475569; cursor: pointer; transition: background 0.2s; }
    .social-btn:hover { background: #f8fafc; }
    .social-btn img { width: 16px; height: 16px; }
    .view-section { animation: fadeIn 0.4s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .custom-checkbox { appearance: none; width: 14px; height: 14px; border: 1px solid #cbd5e1; border-radius: 3px; display: inline-flex; justify-content: center; align-items: center; cursor: pointer; transition: 0.2s; margin-top: 2px; }
    .custom-checkbox:checked { background-color: #1d4ed8; border-color: #1d4ed8; }
    .custom-checkbox:checked::after { content: '\f00c'; font-family: 'Font Awesome 6 Free'; font-weight: 900; color: white; font-size: 9px; }

    .multiselect-dropdown { position: relative; width: 100%; }
    .multiselect-header { width: 100%; padding: 8px 12px; background: white; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 12px; color: #334155; cursor: pointer; display: flex; align-items: center; justify-content: space-between; user-select: none; height: 38px; }
    .multiselect-content { display: none; position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #cbd5e1; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); z-index: 50; max-height: 200px; overflow-y: auto; margin-top: 4px; padding: 6px; }
    .multiselect-content.show { display: block; }
    .multiselect-item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; font-size: 12px; color: #334155; cursor: pointer; border-radius: 6px; transition: background 0.15s; }
    .multiselect-item:hover { background: #f1f5f9; }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* TEMA TABEL STICKY */
    .table-row-data { background-color: #ffffff; }
    .table-row-data:hover { background-color: #eff6ff; }
    .sticky-aksi { position: sticky; left: 0; z-index: 10; width: 85px; min-width: 85px; max-width: 85px; background-color: inherit; }
    .sticky-wo { position: sticky; left: 85px; z-index: 10; background-color: inherit; box-shadow: 3px 0 5px -2px rgba(0,0,0,0.1); }
    .sticky-head-aksi { position: sticky; left: 0; top: 0; z-index: 40 !important; width: 85px; min-width: 85px; max-width: 85px; background-color: #0d55d4 !important; color: white !important; }
    .sticky-head-wo { position: sticky; left: 85px; top: 0; z-index: 40 !important; background-color: #0d55d4 !important; color: white !important; box-shadow: 3px 0 5px -2px rgba(0,0,0,0.2); }
    .sticky-head-other { position: sticky; top: 0; z-index: 30 !important; background-color: #0d55d4 !important; color: white !important; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
    #tech-modal { z-index: 9999 !important; }

    /* --- DASHBOARD CUSTOM CSS --- */
    .dash-card { background: #ffffff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.03); border: 1px solid #f1f5f9; padding: 16px; }
    .icon-box { width: 38px; height: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; margin-bottom: 12px;}
    
    .ic-bg-blue { background: #e0e7ff; color: #4f46e5; }
    .ic-bg-red { background: #fee2e2; color: #ef4444; }
    .ic-bg-orange { background: #ffedd5; color: #f97316; }
    .ic-bg-yellow { background: #fef9c3; color: #eab308; }
    .ic-bg-green { background: #dcfce7; color: #22c55e; }
    
    .dash-title { font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;}
    .dash-num { font-size: 28px; font-weight: 800; color: #1e293b; line-height: 1.1; margin: 4px 0; cursor: pointer; transition: color 0.2s;}
    .dash-num:hover { color: #2563eb; }
    .dash-sub { font-size: 9px; color: #94a3b8; margin-bottom: 12px; font-weight: 500;}
    
    .dash-row { display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 4px; font-weight: 500; cursor: pointer; padding: 2px 4px; border-radius: 4px; transition: background 0.2s; }
    .dash-row:hover { background-color: #f1f5f9; }
    
    .val-blue { color: #2563eb; font-weight: 700;}
    .val-red { color: #ef4444; font-weight: 700;}
    .val-orange { color: #f97316; font-weight: 700;}
    .val-yellow { color: #eab308; font-weight: 700;}
    .val-green { color: #22c55e; font-weight: 700;}
</style>
